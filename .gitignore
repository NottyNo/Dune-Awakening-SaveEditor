# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
.dev-packages/
venv/
env/
ENV/

# Test, lint, type-check, and coverage output
.pytest_cache/
.pytest-tmp/
.mypy_cache/
.pyright/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Packaging and build artifacts
build/
dist/
.eggs/
*.egg-info/
pip-wheel-metadata/

# Local configuration and secrets
.env
.env.*
!.env.example
*.key
*.pem

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
~$*

# Local save-editor data; keep real player saves out of Git
*.db
*.db-*
*.sqlite
*.sqlite3
saves/
backups/
exports/
local-data/
